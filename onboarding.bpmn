<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_Onboarding"
                  targetNamespace="http://taras.skitsko/neobank">

  <bpmn:process id="Process_Onboarding" name="Neobank onboarding — KYC" isExecutable="true">

    <bpmn:startEvent id="Start_Submitted" name="Application&#10;submitted">
      <bpmn:outgoing>F_ToIdem</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Task_Idempotency" name="Resolve idempotency&#10;(find-or-create application)">
      <bpmn:incoming>F_ToIdem</bpmn:incoming>
      <bpmn:outgoing>F_ToValidate</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Task_Validate" name="Validate payload&#10;(schema, age, country)">
      <bpmn:incoming>F_ToValidate</bpmn:incoming>
      <bpmn:outgoing>F_ToValidGw</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gw_Valid" name="valid?">
      <bpmn:incoming>F_ToValidGw</bpmn:incoming>
      <bpmn:outgoing>F_ToScreening</bpmn:outgoing>
      <bpmn:outgoing>F_ValidationReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Screening" name="Sanctions / PEP screening">
      <bpmn:incoming>F_ToScreening</bpmn:incoming>
      <bpmn:outgoing>F_ToScreenGw</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_Screen" name="hit?">
      <bpmn:incoming>F_ToScreenGw</bpmn:incoming>
      <bpmn:outgoing>F_ScreenClear</bpmn:outgoing>
      <bpmn:outgoing>F_ScreenHit</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Synchronous submit, asynchronous decision. The provider calls us back. -->
    <bpmn:serviceTask id="Task_SubmitKyc" name="Submit to KYC provider&#10;(Idempotency-Key)">
      <bpmn:incoming>F_ScreenClear</bpmn:incoming>
      <bpmn:incoming>F_ReArm</bpmn:incoming>
      <bpmn:outgoing>F_ToWait</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Boundary_SubmitTimeout" name="submit&#10;timed out" attachedToRef="Task_SubmitKyc" cancelActivity="true">
      <bpmn:outgoing>F_SubmitUnknown</bpmn:outgoing>
      <bpmn:timerEventDefinition id="T_Submit">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <!-- The async wait: provider decision arrives as a signed webhook -->
    <bpmn:intermediateCatchEvent id="Event_AwaitCallback" name="await provider&#10;callback (signed)">
      <bpmn:incoming>F_ToWait</bpmn:incoming>
      <bpmn:outgoing>F_ToDecisionGw</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Msg_KycResult" messageRef="Message_KycResult" />
    </bpmn:intermediateCatchEvent>

    <bpmn:boundaryEvent id="Boundary_CallbackSla" name="SLA breached&#10;(no callback)" attachedToRef="Event_AwaitCallback" cancelActivity="true">
      <bpmn:outgoing>F_SlaUnknown</bpmn:outgoing>
      <bpmn:timerEventDefinition id="T_Sla">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT6H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="Gw_Decision" name="provider&#10;decision">
      <bpmn:incoming>F_ToDecisionGw</bpmn:incoming>
      <bpmn:outgoing>F_Clear</bpmn:outgoing>
      <bpmn:outgoing>F_Refer</bpmn:outgoing>
      <bpmn:outgoing>F_Decline</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- UNKNOWN: reconcile, never decide -->
    <bpmn:task id="Task_MarkUnknown" name="state = kyc_unknown&#10;(never rejected)">
      <bpmn:incoming>F_SubmitUnknown</bpmn:incoming>
      <bpmn:incoming>F_SlaUnknown</bpmn:incoming>
      <bpmn:outgoing>F_ToBackoff</bpmn:outgoing>
    </bpmn:task>

    <bpmn:intermediateCatchEvent id="Event_Backoff" name="back-off&#10;+ jitter">
      <bpmn:incoming>F_ToBackoff</bpmn:incoming>
      <bpmn:incoming>F_StillUnknown</bpmn:incoming>
      <bpmn:outgoing>F_ToAttemptsGw</bpmn:outgoing>
      <bpmn:timerEventDefinition id="T_Backoff">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gw_Attempts" name="attempts&#10;left?">
      <bpmn:incoming>F_ToAttemptsGw</bpmn:incoming>
      <bpmn:outgoing>F_ToQuery</bpmn:outgoing>
      <bpmn:outgoing>F_Exhausted</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_QueryProvider" name="Query provider by our ref&#10;(GET — never blind resubmit)">
      <bpmn:incoming>F_ToQuery</bpmn:incoming>
      <bpmn:outgoing>F_ToResolvedGw</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gw_Resolved" name="resolved?">
      <bpmn:incoming>F_ToResolvedGw</bpmn:incoming>
      <bpmn:outgoing>F_ResolvedDecision</bpmn:outgoing>
      <bpmn:outgoing>F_NotFound</bpmn:outgoing>
      <bpmn:outgoing>F_StillUnknown</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="Gw_SafeReArm" name="never received&#10;&amp; key valid?">
      <bpmn:incoming>F_NotFound</bpmn:incoming>
      <bpmn:outgoing>F_ReArm</bpmn:outgoing>
      <bpmn:outgoing>F_NoReArm</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Human review — maker/checker, the only path that may decide a REFER -->
    <bpmn:userTask id="Task_Review" name="Compliance review&#10;(maker–checker, 4 eyes)">
      <bpmn:incoming>F_Refer</bpmn:incoming>
      <bpmn:incoming>F_ScreenHit</bpmn:incoming>
      <bpmn:incoming>F_Exhausted</bpmn:incoming>
      <bpmn:incoming>F_NoReArm</bpmn:incoming>
      <bpmn:outgoing>F_ToReviewGw</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gw_Review" name="outcome">
      <bpmn:incoming>F_ToReviewGw</bpmn:incoming>
      <bpmn:outgoing>F_ReviewApprove</bpmn:outgoing>
      <bpmn:outgoing>F_ReviewReject</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Task_Approve" name="state = approved&#10;(durable, audited fact)">
      <bpmn:incoming>F_Clear</bpmn:incoming>
      <bpmn:incoming>F_ResolvedDecision</bpmn:incoming>
      <bpmn:incoming>F_ReviewApprove</bpmn:incoming>
      <bpmn:outgoing>F_ToOpen</bpmn:outgoing>
    </bpmn:task>

    <bpmn:serviceTask id="Task_OpenAccount" name="Open account in core banking&#10;(retry — never un-approve)">
      <bpmn:incoming>F_ToOpen</bpmn:incoming>
      <bpmn:outgoing>F_ToOpened</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Boundary_OpenFailed" name="core&#10;unavailable" attachedToRef="Task_OpenAccount" cancelActivity="false">
      <bpmn:outgoing>F_OpenEscalate</bpmn:outgoing>
      <bpmn:errorEventDefinition id="Err_Core" />
    </bpmn:boundaryEvent>

    <bpmn:task id="Task_OpsQueue" name="Ops queue&#10;(approved, not yet opened)">
      <bpmn:incoming>F_OpenEscalate</bpmn:incoming>
      <bpmn:outgoing>F_ToOpsEnd</bpmn:outgoing>
    </bpmn:task>

    <bpmn:endEvent id="End_Opened" name="account_opened">
      <bpmn:incoming>F_ToOpened</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Ops" name="Held in ops&#10;(approval intact)">
      <bpmn:incoming>F_ToOpsEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rejected" name="rejected">
      <bpmn:incoming>F_ValidationReject</bpmn:incoming>
      <bpmn:incoming>F_Decline</bpmn:incoming>
      <bpmn:incoming>F_ReviewReject</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="F_ToIdem" sourceRef="Start_Submitted" targetRef="Task_Idempotency" />
    <bpmn:sequenceFlow id="F_ToValidate" sourceRef="Task_Idempotency" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="F_ToValidGw" sourceRef="Task_Validate" targetRef="Gw_Valid" />
    <bpmn:sequenceFlow id="F_ToScreening" name="yes" sourceRef="Gw_Valid" targetRef="Task_Screening" />
    <bpmn:sequenceFlow id="F_ValidationReject" name="no" sourceRef="Gw_Valid" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F_ToScreenGw" sourceRef="Task_Screening" targetRef="Gw_Screen" />
    <bpmn:sequenceFlow id="F_ScreenClear" name="clear" sourceRef="Gw_Screen" targetRef="Task_SubmitKyc" />
    <bpmn:sequenceFlow id="F_ScreenHit" name="hit → mandatory human" sourceRef="Gw_Screen" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F_ToWait" sourceRef="Task_SubmitKyc" targetRef="Event_AwaitCallback" />
    <bpmn:sequenceFlow id="F_ToDecisionGw" sourceRef="Event_AwaitCallback" targetRef="Gw_Decision" />
    <bpmn:sequenceFlow id="F_Clear" name="CLEAR" sourceRef="Gw_Decision" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="F_Refer" name="REFER" sourceRef="Gw_Decision" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F_Decline" name="DECLINE" sourceRef="Gw_Decision" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F_SubmitUnknown" sourceRef="Boundary_SubmitTimeout" targetRef="Task_MarkUnknown" />
    <bpmn:sequenceFlow id="F_SlaUnknown" sourceRef="Boundary_CallbackSla" targetRef="Task_MarkUnknown" />
    <bpmn:sequenceFlow id="F_ToBackoff" sourceRef="Task_MarkUnknown" targetRef="Event_Backoff" />
    <bpmn:sequenceFlow id="F_ToAttemptsGw" sourceRef="Event_Backoff" targetRef="Gw_Attempts" />
    <bpmn:sequenceFlow id="F_ToQuery" name="yes" sourceRef="Gw_Attempts" targetRef="Task_QueryProvider" />
    <bpmn:sequenceFlow id="F_Exhausted" name="exhausted" sourceRef="Gw_Attempts" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F_ToResolvedGw" sourceRef="Task_QueryProvider" targetRef="Gw_Resolved" />
    <bpmn:sequenceFlow id="F_ResolvedDecision" name="found: CLEAR" sourceRef="Gw_Resolved" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="F_NotFound" name="never received" sourceRef="Gw_Resolved" targetRef="Gw_SafeReArm" />
    <bpmn:sequenceFlow id="F_StillUnknown" name="still indeterminate" sourceRef="Gw_Resolved" targetRef="Event_Backoff" />
    <bpmn:sequenceFlow id="F_ReArm" name="yes — same key" sourceRef="Gw_SafeReArm" targetRef="Task_SubmitKyc" />
    <bpmn:sequenceFlow id="F_NoReArm" name="no — human" sourceRef="Gw_SafeReArm" targetRef="Task_Review" />
    <bpmn:sequenceFlow id="F_ToReviewGw" sourceRef="Task_Review" targetRef="Gw_Review" />
    <bpmn:sequenceFlow id="F_ReviewApprove" name="approve" sourceRef="Gw_Review" targetRef="Task_Approve" />
    <bpmn:sequenceFlow id="F_ReviewReject" name="reject" sourceRef="Gw_Review" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="F_ToOpen" sourceRef="Task_Approve" targetRef="Task_OpenAccount" />
    <bpmn:sequenceFlow id="F_ToOpened" sourceRef="Task_OpenAccount" targetRef="End_Opened" />
    <bpmn:sequenceFlow id="F_OpenEscalate" sourceRef="Boundary_OpenFailed" targetRef="Task_OpsQueue" />
    <bpmn:sequenceFlow id="F_ToOpsEnd" sourceRef="Task_OpsQueue" targetRef="End_Ops" />

  </bpmn:process>

  <bpmn:message id="Message_KycResult" name="kyc.result" />

  <bpmndi:BPMNDiagram id="D_1">
    <bpmndi:BPMNPlane id="P_1" bpmnElement="Process_Onboarding">
      <bpmndi:BPMNShape id="s1" bpmnElement="Start_Submitted"><dc:Bounds x="140" y="222" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="122" y="265" width="74" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s2" bpmnElement="Task_Idempotency"><dc:Bounds x="230" y="200" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s3" bpmnElement="Task_Validate"><dc:Bounds x="420" y="200" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s4" bpmnElement="Gw_Valid" isMarkerVisible="true"><dc:Bounds x="605" y="215" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="612" y="272" width="36" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s5" bpmnElement="Task_Screening"><dc:Bounds x="700" y="200" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s6" bpmnElement="Gw_Screen" isMarkerVisible="true"><dc:Bounds x="895" y="215" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="908" y="272" width="26" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s7" bpmnElement="Task_SubmitKyc"><dc:Bounds x="990" y="200" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s8" bpmnElement="Boundary_SubmitTimeout"><dc:Bounds x="1042" y="262" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1022" y="302" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s9" bpmnElement="Event_AwaitCallback"><dc:Bounds x="1192" y="222" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1166" y="180" width="90" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s10" bpmnElement="Boundary_CallbackSla"><dc:Bounds x="1210" y="240" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1248" y="248" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s11" bpmnElement="Gw_Decision" isMarkerVisible="true"><dc:Bounds x="1300" y="215" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1288" y="172" width="74" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s12" bpmnElement="Task_Approve"><dc:Bounds x="1430" y="200" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s13" bpmnElement="Task_OpenAccount"><dc:Bounds x="1630" y="200" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s14" bpmnElement="Boundary_OpenFailed"><dc:Bounds x="1692" y="262" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1672" y="302" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s15" bpmnElement="End_Opened"><dc:Bounds x="1852" y="222" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1832" y="265" width="82" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s16" bpmnElement="Task_OpsQueue"><dc:Bounds x="1630" y="360" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s17" bpmnElement="End_Ops"><dc:Bounds x="1852" y="382" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1824" y="425" width="94" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s18" bpmnElement="Task_MarkUnknown"><dc:Bounds x="990" y="400" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s19" bpmnElement="Event_Backoff"><dc:Bounds x="902" y="422" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="886" y="465" width="70" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s20" bpmnElement="Gw_Attempts" isMarkerVisible="true"><dc:Bounds x="785" y="415" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="775" y="472" width="70" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s21" bpmnElement="Task_QueryProvider"><dc:Bounds x="730" y="540" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s22" bpmnElement="Gw_Resolved" isMarkerVisible="true"><dc:Bounds x="965" y="555" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="956" y="612" width="68" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s23" bpmnElement="Gw_SafeReArm" isMarkerVisible="true"><dc:Bounds x="1125" y="555" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1105" y="612" width="92" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s24" bpmnElement="Task_Review"><dc:Bounds x="1300" y="400" width="170" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s25" bpmnElement="Gw_Review" isMarkerVisible="true"><dc:Bounds x="1520" y="415" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1512" y="472" width="50" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s26" bpmnElement="End_Rejected"><dc:Bounds x="1852" y="530" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1848" y="573" width="48" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="e1" bpmnElement="F_ToIdem"><di:waypoint x="176" y="240" /><di:waypoint x="230" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e2" bpmnElement="F_ToValidate"><di:waypoint x="380" y="240" /><di:waypoint x="420" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e3" bpmnElement="F_ToValidGw"><di:waypoint x="560" y="240" /><di:waypoint x="605" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e4" bpmnElement="F_ToScreening"><di:waypoint x="655" y="240" /><di:waypoint x="700" y="240" /><bpmndi:BPMNLabel><dc:Bounds x="662" y="222" width="24" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e5" bpmnElement="F_ValidationReject"><di:waypoint x="630" y="265" /><di:waypoint x="630" y="700" /><di:waypoint x="1870" y="700" /><di:waypoint x="1870" y="566" /><bpmndi:BPMNLabel><dc:Bounds x="636" y="300" width="20" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e6" bpmnElement="F_ToScreenGw"><di:waypoint x="850" y="240" /><di:waypoint x="895" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e7" bpmnElement="F_ScreenClear"><di:waypoint x="945" y="240" /><di:waypoint x="990" y="240" /><bpmndi:BPMNLabel><dc:Bounds x="948" y="222" width="34" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e8" bpmnElement="F_ScreenHit"><di:waypoint x="920" y="215" /><di:waypoint x="920" y="150" /><di:waypoint x="1385" y="150" /><di:waypoint x="1385" y="400" /><bpmndi:BPMNLabel><dc:Bounds x="1050" y="132" width="150" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e9" bpmnElement="F_ToWait"><di:waypoint x="1140" y="240" /><di:waypoint x="1192" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e10" bpmnElement="F_ToDecisionGw"><di:waypoint x="1228" y="240" /><di:waypoint x="1300" y="240" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e11" bpmnElement="F_Clear"><di:waypoint x="1350" y="240" /><di:waypoint x="1430" y="240" /><bpmndi:BPMNLabel><dc:Bounds x="1360" y="222" width="42" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e12" bpmnElement="F_Refer"><di:waypoint x="1325" y="265" /><di:waypoint x="1325" y="400" /><bpmndi:BPMNLabel><dc:Bounds x="1331" y="320" width="42" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e13" bpmnElement="F_Decline"><di:waypoint x="1340" y="255" /><di:waypoint x="1600" y="255" /><di:waypoint x="1600" y="660" /><di:waypoint x="1870" y="660" /><di:waypoint x="1870" y="566" /><bpmndi:BPMNLabel><dc:Bounds x="1610" y="640" width="54" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e14" bpmnElement="F_SubmitUnknown"><di:waypoint x="1060" y="298" /><di:waypoint x="1060" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e15" bpmnElement="F_SlaUnknown"><di:waypoint x="1228" y="276" /><di:waypoint x="1228" y="340" /><di:waypoint x="1100" y="340" /><di:waypoint x="1100" y="400" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e16" bpmnElement="F_ToBackoff"><di:waypoint x="990" y="440" /><di:waypoint x="938" y="440" /></bpmndi:BPMNEdge>
